# SimAgents Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Model Selection ───────────────────────────────────────────────────────
# Set USE_LOCAL=true for Ollama (free, local), false for OpenAI API (paid)
USE_LOCAL=false

# OpenAI API key — required when USE_LOCAL=false
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Ollama Configuration (for local models)
OLLAMA_BASE_URL=http://localhost:11434

# Model names
OPENAI_MODEL=gpt-4o-mini
LOCAL_MODEL=llama3.2

# ── LLM Parameters ───────────────────────────────────────────────────────
# Temperature: 0.0 = deterministic, 1.0 = highly varied. Default 0.7
TEMPERATURE=0.7

# Seed: optional fixed seed for reproducible outputs. Leave blank for varied runs.
SEED=
